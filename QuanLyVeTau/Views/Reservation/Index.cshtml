@model List<QuanLyVeTau.Models.GiuCho>

<h2>Danh sách giữ chỗ</h2>

<a href="/Reservation/Create">
    Thêm giữ chỗ
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>ID đặt chỗ</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.DatChoId</td>

            <td>

                <a href="/Reservation/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Reservation/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>