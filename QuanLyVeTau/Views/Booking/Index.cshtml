@model List<QuanLyVeTau.Models.DatCho>

<h2>Danh sách đặt chỗ</h2>

<a href="/Booking/Create">
    Thêm đặt chỗ
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Mã đặt chỗ</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.MaDatCho</td>

            <td>

                <a href="/Booking/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Booking/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>