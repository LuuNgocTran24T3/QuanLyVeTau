@model List<QuanLyVeTau.Models.BangGia>

<h2>Danh sách giá</h2>

<a href="/Price/Create">
    Thêm giá
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Giá cơ sở</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.GiaCoSo</td>

            <td>

                <a href="/Price/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Price/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>