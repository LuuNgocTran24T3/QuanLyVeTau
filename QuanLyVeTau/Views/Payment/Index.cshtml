@model List<QuanLyVeTau.Models.ThanhToan>

<h2>Danh sách thanh toán</h2>

<a href="/Payment/Create">
    Thêm thanh toán
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Mã giao dịch</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.MaGiaoDich</td>

            <td>

                <a href="/Payment/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Payment/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>