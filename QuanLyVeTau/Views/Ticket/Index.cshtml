@model List<QuanLyVeTau.Models.Ve>

<h2>Danh sách vé</h2>

<a href="/Ticket/Create">
    Thêm vé
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Tên vé</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.TenVe</td>

            <td>

                <a href="/Ticket/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Ticket/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>