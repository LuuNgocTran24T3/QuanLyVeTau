@model List<QuanLyVeTau.Models.LichSuDoiTra>

<h2>Danh sách lịch sử đổi trả</h2>

<a href="/ReturnHistory/Create">
    Thêm lịch sử đổi trả
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Loại giao dịch</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.LoaiGiaoDich</td>

            <td>

                <a href="/ReturnHistory/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/ReturnHistory/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>