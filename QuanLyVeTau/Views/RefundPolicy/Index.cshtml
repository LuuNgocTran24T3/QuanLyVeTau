@model List<QuanLyVeTau.Models.ChinhSachDoiTra>

<h2>Danh sách chính sách đổi trả</h2>

<a href="/RefundPolicy/Create">
    Thêm chính sách đổi trả
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Tên chính sách</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.TenChinhSach</td>

            <td>

                <a href="/RefundPolicy/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/RefundPolicy/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>