@model List<QuanLyVeTau.Models.HoanTien>

<h2>Danh sách hoàn tiền</h2>

<a href="/Refund/Create">
    Thêm hoàn tiền
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Số tiền hoàn</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.SoTienHoan</td>

            <td>

                <a href="/Refund/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Refund/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>