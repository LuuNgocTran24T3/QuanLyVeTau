@model List<QuanLyVeTau.Models.Tau>

<h2>Danh sách tàu</h2>

<a href="/Train/Create">
    Thêm tàu
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Tên tàu</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.TenTau</td>

            <td>

                <a href="/Train/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Train/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>