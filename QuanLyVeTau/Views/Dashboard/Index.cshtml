@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">Dashboard Admin</h2>

<div class="row">

    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5>Tổng số tàu</h5>
                <h2>@ViewBag.TotalTrain</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5>Tổng số vé</h5>
                <h2>@ViewBag.TotalTicket</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5>Khách hàng</h5>
                <h2>@ViewBag.TotalCustomer</h2>
            </div>
        </div>
    </div>

</div>