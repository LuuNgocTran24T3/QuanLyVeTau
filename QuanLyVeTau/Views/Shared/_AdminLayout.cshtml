@{
    var role = Context.Session.GetString("role");
    var name = Context.Session.GetString("name");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hệ thống vé tàu</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <style>
            body {
                background: #f4f6f9;
            }

            .sidebar {
                width: 260px;
                min-height: 100vh;
                background: #212529;
                color: white;
                position: fixed;
            }

                .sidebar a {
                    color: white;
                    text-decoration: none;
                }

                    .sidebar a:hover {
                        background: #343a40;
                        border-radius: 8px;
                    }

            .content {
                margin-left: 260px;
                padding: 20px;
            }

            .brand {
                font-size: 20px;
                font-weight: bold;
                padding: 15px;
                border-bottom: 1px solid #444;
            }

            .menu {
                padding: 10px;
            }

                .menu a {
                    display: block;
                    padding: 10px;
                    margin-bottom: 5px;
                }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">

        <div class="brand">
            🚆 VÉ TÀU SYSTEM
        </div>

        <div class="menu">

            <p class="text-secondary">Xin chào: @name</p>
            <p class="text-warning">Role: @role</p>

            <hr />

            <!-- STAFF MENU -->
            @if (role == "Staff")
            {
                <a href="/Dashboard"><i class="fa fa-chart-line"></i> Dashboard</a>

                <a href="/Train"><i class="fa fa-train"></i> Quản lý tàu</a>

                <a href="/Station"><i class="fa fa-map"></i> Quản lý ga</a>

                <a href="/Ticket"><i class="fa fa-ticket"></i> Quản lý vé</a>

                <a href="/Booking"><i class="fa fa-book"></i> Quản lý đặt chỗ</a>

                <a href="/Payment"><i class="fa fa-credit-card"></i> Thanh toán</a>

                <a href="/Refund"><i class="fa fa-rotate-left"></i> Hoàn tiền</a>

                <a href="/Promotion"><i class="fa fa-gift"></i> Khuyến mãi</a>
            }

            <!-- CUSTOMER MENU -->
            @if (role == "Customer")
            {
                <a href="/Home"><i class="fa fa-home"></i> Trang chủ</a>

                <a href="/Booking/Create"><i class="fa fa-ticket"></i> Đặt vé</a>

                <a href="/Ticket/MyTicket"><i class="fa fa-list"></i> Vé của tôi</a>

                <a href="/Refund/Create"><i class="fa fa-rotate-left"></i> Yêu cầu hoàn tiền</a>
            }

            <hr />

            <a href="/Account/Logout" class="text-danger">
                <i class="fa fa-sign-out"></i> Đăng xuất
            </a>

            <a href="/Dashboard">
                <i class="fa fa-chart-line"></i> Dashboard
            </a>

        </div>
    </div>

    <!-- CONTENT -->
    <div class="content">

        @RenderBody()

    </div>

</body>
</html>