@model List<QuanLyVeTau.Models.KhuyenMai>

<h2>Danh sách khuyến mãi</h2>

<a href="/Promotion/Create">
    Thêm khuyến mãi
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Tên chương trình</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.TenChuongTrinh</td>

            <td>

                <a href="/Promotion/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Promotion/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>