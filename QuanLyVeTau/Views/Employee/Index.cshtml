@model List<QuanLyVeTau.Models.NhanVien>

<h2>Danh sách nhân viên</h2>

<a href="/Employee/Create">
    Thêm nhân viên
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Tên nhân viên</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.HoTen</td>

            <td>

                <a href="/Employee/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Employee/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>