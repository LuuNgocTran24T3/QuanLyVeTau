@model List<QuanLyVeTau.Models.Ga>

<h2>Danh sách ga</h2>

<a href="/Station/Create">
    Thêm ga
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Tên tàu</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.TenGa</td>

            <td>

                <a href="/Station/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Station/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>