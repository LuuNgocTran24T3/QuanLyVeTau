@model List<QuanLyVeTau.Models.LichDung>

<h2>Danh sách lịch dừng</h2>

<a href="/Schedule/Create">
    Thêm lịch dừng
</a>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Thứ tự dừng</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.ThuTuDung</td>

            <td>

                <a href="/Schedule/Edit/@item.Id">
                    Sửa
                </a>

                <a href="/Schedule/Delete/@item.Id">
                    Xóa
                </a>

            </td>

        </tr>
    }

</table>